{
  "name": "national-capability-benchmark",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "bench": "pnpm --filter @ncb/core exec tsx src/cli/index.ts",
    "changelog:check": "node scripts/check-changelog.mjs",
    "prebuild": "pnpm changelog:check",
    "pretypecheck": "pnpm changelog:check",
    "ingest": "pnpm bench ingest",
    "delphi": "pnpm bench delphi",
    "score": "pnpm bench score",
    "diagnose": "pnpm bench diagnose",
    "reviews:check": "node scripts/check-provisional-reviews.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @ncb/core test",
    "dev": "pnpm --filter @ncb/web dev",
    "icons": "node scripts/generate-favicons.mjs",
    "icons:measure": "node scripts/measure-icons.mjs"
  },
  "devDependencies": {
    "sharp": "^0.34.0",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
