{
  "name": "@ncb/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "next dev --port 3888",
    "prebuild": "pnpm --dir ../.. changelog:check",
    "pretypecheck": "pnpm --dir ../.. changelog:check",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "portless": {
    "name": "ncb",
    "script": "dev:app",
    "appPort": 3888
  },
  "dependencies": {
    "@ncb/core": "workspace:*",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.2"
  }
}
