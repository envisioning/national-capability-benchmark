AI_GATEWAY_API_KEY=
# Public origin used for canonical links and metadata.
NEXT_PUBLIC_SITE_URL=https://ncb.envisioning.com
# Plausible site hostname. Create this site in Plausible before deployment.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ncb.envisioning.com
# Optional: replace with the site-specific script URL from Plausible.
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
# Gateway model ids, comma separated. One panelist per stance, models dealt round-robin.
# Verify these against the gateway's model list before a run; ids change.
NCB_PANEL=anthropic/claude-opus-5,openai/gpt-5,google/gemini-2.5-pro

# The contact form forwards to core.envisioning.com, which owns the CRM.
# Without INTERNAL_REQUEST_SECRET the endpoint answers 503 and sends nothing.
CORE_API_URL=https://core.envisioning.com
INTERNAL_REQUEST_SECRET=
# Cloudflare Turnstile. Optional: with no secret the form runs unverified.
TURNSTILE_SECRET_KEY=
